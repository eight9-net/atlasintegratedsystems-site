      "roundness": null,
      "seed": 486,
      "version": 1,
      "versionNonce": 487,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Project Description: New fiber optic network for FPL’s Kramer Junction\nSolar Site",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Project Description: New fiber optic network for FPL’s Kramer Junction\nSolar Site",
      "lineHeight": 1.4
    },
    {
      "id": "ce_body",
      "type": "text",
      "x": 406,
      "y": 5982,
      "width": 628,
      "height": 107,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 488,
      "version": 1,
      "versionNonce": 489,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Our client, Florida Power & Light, needed to upgrade its fiber optic network and\ngive it room to grow. They required underground and aerial cost estimates to\nevaluate which would be the most viable solution. We designed the most\ncost-effective system and installed over 2 miles of network infrastructure both\nincorporating both aerial and underground designs while not disturbing plant\noperations at the peak of their season.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our client, Florida Power & Light, needed to upgrade its fiber optic network and\ngive it room to grow. They required underground and aerial cost estimates to\nevaluate which would be the most viable solution. We designed the most\ncost-effective system and installed over 2 miles of network infrastructure both\nincorporating both aerial and underground designs while not disturbing plant\noperations at the peak of their season.",
      "lineHeight": 1.4
    },

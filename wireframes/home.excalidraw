    {
      "id": "wwa_body",
      "type": "text",
      "x": 32,
      "y": 2520,
      "width": 656,
      "height": 107,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 242,
      "version": 1,
      "versionNonce": 243,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Our company is a leader in providing design, production and maintenance support of\ncommunications systems for industrial and municipal customers in Southern California.\nWhile our products and systems are primarily focused on the physical layer of networked\napplications, our Municipal Systems business also offers services and systems for\nHomeland Security, Government and commercial applications. We also provide a wide range\nof services and support to our customers through our network of subcontractors.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our company is a leader in providing design, production and maintenance support of\ncommunications systems for industrial and municipal customers in Southern California.\nWhile our products and systems are primarily focused on the physical layer of networked\napplications, our Municipal Systems business also offers services and systems for\nHomeland Security, Government and commercial applications. We also provide a wide range\nof services and support to our customers through our network of subcontractors.",
      "lineHeight": 1.4
    },

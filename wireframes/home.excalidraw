    {
      "id": "rpr_body_4",
      "type": "text",
      "x": 96,
      "y": 4064,
      "width": 1240,
      "height": 68,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 354,
      "version": 1,
      "versionNonce": 355,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas Integrated Systems, Inc. was tasked with the crucial job of certifying the fiber optic communications systems for the processing functions at the new Data\nCenter on Camp Pendleton Marine Base. They conducted comprehensive OTDR Testing on over 5,000 fiber connectors within 300 enclosed racks, ensuring that both\nSIPRNet and NIPRNet connections met rigorous standards. Their work included meticulous documentation and the repair of any components that did not meet the\nrequired specifications.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas Integrated Systems, Inc. was tasked with the crucial job of certifying the fiber optic communications systems for the processing functions at the new Data\nCenter on Camp Pendleton Marine Base. They conducted comprehensive OTDR Testing on over 5,000 fiber connectors within 300 enclosed racks, ensuring that both\nSIPRNet and NIPRNet connections met rigorous standards. Their work included meticulous documentation and the repair of any components that did not meet the\nrequired specifications.",
      "lineHeight": 1.4
    },

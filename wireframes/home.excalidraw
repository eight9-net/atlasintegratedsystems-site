      "seed": 466,
      "version": 1,
      "versionNonce": 467,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The City of San Diego's pipeline and communications network infrastructure was finally\nlinked together. However, the signal loss was too great from its South Bay facilities to\nits Operations Center over 22 miles away. Segments had been patched together and\ninstalled over a period of more than 10 years in some areas.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The City of San Diego's pipeline and communications network infrastructure was finally\nlinked together. However, the signal loss was too great from its South Bay facilities to\nits Operations Center over 22 miles away. Segments had been patched together and\ninstalled over a period of more than 10 years in some areas.",
      "lineHeight": 1.4
    },
    {
      "id": "ts_p2",
      "type": "text",
      "x": 752,
      "y": 5654,
      "width": 656,
      "height": 57,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 468,
      "version": 1,
      "versionNonce": 469,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas was able to isolate the problem areas, and fix all the problems without disturbing\nthe citywide plant, lowering the signal loss substantially and establishing the\ncommunications link the City required.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas was able to isolate the problem areas, and fix all the problems without disturbing\nthe citywide plant, lowering the signal loss substantially and establishing the\ncommunications link the City required.",
      "lineHeight": 1.4
    },

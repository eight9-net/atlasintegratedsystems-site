    {
      "id": "dp_body",
      "type": "text",
      "x": 32,
      "y": 4286,
      "width": 656,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 364,
      "version": 1,
      "versionNonce": 365,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Using the most relevant technologies allows Atlas the flexibility to retrofit as well as\nbuild out an entire new infrastructure. This provides the best ROI for our clients. Our\ntechnical expertise is unmatched in our ability to provide as-built drawings and\nmatrices for sites that have little or no information on existing infrastructure. This\nis crucial for finding what may be utilized, saving thousands of dollars and downtime.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Using the most relevant technologies allows Atlas the flexibility to retrofit as well as\nbuild out an entire new infrastructure. This provides the best ROI for our clients. Our\ntechnical expertise is unmatched in our ability to provide as-built drawings and\nmatrices for sites that have little or no information on existing infrastructure. This\nis crucial for finding what may be utilized, saving thousands of dollars and downtime.",
      "lineHeight": 1.4
    },

      "link": null,
      "locked": false,
      "text": "AES-KIUC Lāwaʻi Solar Project",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AES-KIUC Lāwaʻi Solar Project",
      "lineHeight": 1.4
    },
    {
      "id": "rpr_rt_1",
      "type": "text",
      "x": 96,
      "y": 3708,
      "width": 1140,
      "height": 19,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 316,
      "version": 1,
      "versionNonce": 317,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "{ name: 'projects', hash: '#LawaiSolarProject' }",
      "fontSize": 9,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{ name: 'projects', hash: '#LawaiSolarProject' }",
      "lineHeight": 1.4
    },
    {
      "id": "rpr_body_1",
      "type": "text",
      "x": 96,
      "y": 3728,
      "width": 1240,
      "height": 83,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 318,
      "version": 1,
      "versionNonce": 319,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas Integrated Systems, Inc. played a crucial role in the Lāwaʻi Solar Project, known as the world's largest solar storage peaker at the time, by installing\ncutting-edge SCADA communications and energy control networks beginning in 2018. They expertly handled the complex task of integrating new fiber optic and\ncopper communications into the active plant, contributing to the project's success through 2019, with ongoing enhancements for new and reconfigured systems.\nPost-completion, AES recognized Atlas's expertise by entrusting them with the design of future PoE panels and setting standards for Operations and Maintenance\nbuildings.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas Integrated Systems, Inc. played a crucial role in the Lāwaʻi Solar Project, known as the world's largest solar storage peaker at the time, by installing\ncutting-edge SCADA communications and energy control networks beginning in 2018. They expertly handled the complex task of integrating new fiber optic and\ncopper communications into the active plant, contributing to the project's success through 2019, with ongoing enhancements for new and reconfigured systems.\nPost-completion, AES recognized Atlas's expertise by entrusting them with the design of future PoE panels and setting standards for Operations and Maintenance\nbuildings.",
      "lineHeight": 1.4
    },

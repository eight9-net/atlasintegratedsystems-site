    {
      "id": "rp_sld_body",
      "type": "text",
      "x": 160,
      "y": 3036,
      "width": 1120,
      "height": 97,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 272,
      "version": 1,
      "versionNonce": 273,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas Integrated Systems, Inc. is actively involved in the City-wide Pure Water Project in San Diego, handling the installation of\nextensive Fiber Optic Communication Systems for public utilities and security networks. Their comprehensive services include\ndesign engineering, documentation, and providing detailed budgetary estimates for each phase, while ensuring compliance with\nsafety and wage regulations. Atlas operates both as a direct contractor and subcontractor, coordinating closely with various\ncompanies to update infrastructure and support system redundancy.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas Integrated Systems, Inc. is actively involved in the City-wide Pure Water Project in San Diego, handling the installation of\nextensive Fiber Optic Communication Systems for public utilities and security networks. Their comprehensive services include\ndesign engineering, documentation, and providing detailed budgetary estimates for each phase, while ensuring compliance with\nsafety and wage regulations. Atlas operates both as a direct contractor and subcontractor, coordinating closely with various\ncompanies to update infrastructure and support system redundancy.",
      "lineHeight": 1.4
    },

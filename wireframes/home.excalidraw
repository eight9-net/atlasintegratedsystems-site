    {
      "id": "rpr_body_3",
      "type": "text",
      "x": 96,
      "y": 3952,
      "width": 1240,
      "height": 53,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 342,
      "version": 1,
      "versionNonce": 343,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas Integrated Systems, Inc. successfully installed roughly 4,800 feet of new 12-fiber OM3 multimode cable for a SCADA network, terminating and testing\nconnections across 12 locations with new patch panels and cabinets. The project also involved the installation of innerducts and the certification of the entire\nadministration building's communication systems to ensure optimal performance and system integrity.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas Integrated Systems, Inc. successfully installed roughly 4,800 feet of new 12-fiber OM3 multimode cable for a SCADA network, terminating and testing\nconnections across 12 locations with new patch panels and cabinets. The project also involved the installation of innerducts and the certification of the entire\nadministration building's communication systems to ensure optimal performance and system integrity.",
      "lineHeight": 1.4
    },

      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Project Description: Hybrid Communications For FPL’s Cabazon Wind Energy Site",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Project Description: Hybrid Communications For FPL’s Cabazon Wind Energy Site",
      "lineHeight": 1.4
    },
    {
      "id": "inn_p2",
      "type": "text",
      "x": 32,
      "y": 6410,
      "width": 656,
      "height": 57,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 504,
      "version": 1,
      "versionNonce": 505,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Once again our client Florida Power & Light needed a solution that was both\ncost-effective and functional. The SCADA system at their Cabazon Wind location\nneeded updates.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Once again our client Florida Power & Light needed a solution that was both\ncost-effective and functional. The SCADA system at their Cabazon Wind location\nneeded updates.",
      "lineHeight": 1.4
    },
    {
      "id": "inn_p3",
      "type": "text",
      "x": 32,
      "y": 6488,
      "width": 656,
      "height": 74,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 506,
      "version": 1,
      "versionNonce": 507,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "After assessing the plant's needs, and its number of turbines, we incorporated\na Hybrid communication system. We used “mesh radio” RF technologies and a\nbackbone fiber optic trunk that would increase reporting speeds without the\nexpense of trenching new fiber optic cable to every wind turbine location.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After assessing the plant's needs, and its number of turbines, we incorporated\na Hybrid communication system. We used “mesh radio” RF technologies and a\nbackbone fiber optic trunk that would increase reporting speeds without the\nexpense of trenching new fiber optic cable to every wind turbine location.",
      "lineHeight": 1.4
    },

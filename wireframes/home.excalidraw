      "text": "Cost Efficient Network Upgrades",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cost Efficient Network Upgrades",
      "lineHeight": 1.4
    },
    {
      "id": "ce_sub",
      "type": "text",
      "x": 406,
      "y": 5948,
      "width": 628,
      "height": 43,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,

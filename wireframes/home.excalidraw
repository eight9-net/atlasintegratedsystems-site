    {
      "id": "rpr_body_2",
      "type": "text",
      "x": 96,
      "y": 3840,
      "width": 1240,
      "height": 53,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 330,
      "version": 1,
      "versionNonce": 331,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "For the Pacific Missile Range Facility, Atlas Integrated Systems, Inc. was instrumental in integrating power from the AES-KIUC Solar site to support the Navy\nbase's operations. They managed the installation of approximately 29,000 feet of new cabling infrastructure, meeting strict military specifications, and\nprovided certification testing for the base's communication systems to ensure reliability and security.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For the Pacific Missile Range Facility, Atlas Integrated Systems, Inc. was instrumental in integrating power from the AES-KIUC Solar site to support the Navy\nbase's operations. They managed the installation of approximately 29,000 feet of new cabling infrastructure, meeting strict military specifications, and\nprovided certification testing for the base's communication systems to ensure reliability and security.",
      "lineHeight": 1.4
    },

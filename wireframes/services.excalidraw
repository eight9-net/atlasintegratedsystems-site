      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "• Enhanced security\n• Restricted access for approved personnel\n• Improved Image\n• Convenience",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Enhanced security\n• Restricted access for approved personnel\n• Improved Image\n• Convenience",
      "lineHeight": 1.4
    },
    {
      "id": "eas_list2_hdr",
      "type": "text",
      "x": 32,
      "y": 2240,
      "width": 656,

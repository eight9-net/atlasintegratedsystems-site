      "roundness": null,
      "seed": 184,
      "version": 1,
      "versionNonce": 185,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "One of the top three most important parts of a communications system design is a\nwell-designed and deployed infrastructure backbone. An optimized and correctly placed\ncommunications backbone will give your business the dependable copper/fiber\ninfrastructure it needs to handle the applications of today and tomorrow in the quickly\ndeveloping field of technology. An organized network architecture that can endure the\ntask is necessary for your daily operations.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One of the top three most important parts of a communications system design is a\nwell-designed and deployed infrastructure backbone. An optimized and correctly placed\ncommunications backbone will give your business the dependable copper/fiber\ninfrastructure it needs to handle the applications of today and tomorrow in the quickly\ndeveloping field of technology. An organized network architecture that can endure the\ntask is necessary for your daily operations.",
      "lineHeight": 1.4
    },

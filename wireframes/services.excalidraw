      "roundness": null,
      "seed": 162,
      "version": 1,
      "versionNonce": 163,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas can assess your existing system and make repairs as necessary. We can also\npinpoint a weakness at the design point and implement changes to avoid system failures.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas can assess your existing system and make repairs as necessary. We can also\npinpoint a weakness at the design point and implement changes to avoid system failures.",
      "lineHeight": 1.4
    },

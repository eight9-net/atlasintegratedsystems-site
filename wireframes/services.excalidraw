      "versionNonce": 207,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Technology is here to stay and is always evolving. Our specialists work with producers\nand suppliers to develop a \"future-proof\" design that will offer an access control\nsystem for both the present and the future.",
      "fontSize": 12,

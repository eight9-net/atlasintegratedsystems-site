      "versionNonce": 145,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Our crew at Atlas Integrated Systems, Inc. is made up of experts in communication\nsystems design with an average age of 15 years of experience in the IT industry. Their\nbasic training and licensure are a good starting point, but to stay current on new\ntechnologies, their functions, and how to properly integrate them into your network\ninfrastructure, our communication system design specialists attend ongoing workshops,\nwebinars, and training sessions. This helps to promote a communication system that is\nfit for the future.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our crew at Atlas Integrated Systems, Inc. is made up of experts in communication\nsystems design with an average age of 15 years of experience in the IT industry. Their\nbasic training and licensure are a good starting point, but to stay current on new\ntechnologies, their functions, and how to properly integrate them into your network\ninfrastructure, our communication system design specialists attend ongoing workshops,\nwebinars, and training sessions. This helps to promote a communication system that is\nfit for the future.",
      "lineHeight": 1.4
    },

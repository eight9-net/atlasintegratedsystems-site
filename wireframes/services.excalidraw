    {
      "id": "bi_body",
      "type": "text",
      "x": 752,
      "y": 1764,
      "width": 656,
      "height": 107,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,

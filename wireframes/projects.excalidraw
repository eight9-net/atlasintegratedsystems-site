      "locked": false,
      "text": "Environmental and Economic Benefits",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Environmental and Economic Benefits",
      "lineHeight": 1.4
    },
    {
      "id": "p3_eb_body",
      "type": "text",
      "x": 752,
      "y": 5848,
      "width": 656,
      "height": 107,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 354,
      "version": 1,
      "versionNonce": 355,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The consolidation of the PMRF power grid under Project P-416 represents a significant\nleap forward in environmental and economic efficiency. This initiative reduces the\ncarbon footprint by optimizing energy distribution and usage, contributing to the\nDepartment of Defense's sustainability goals. Economically, the project promises\nenhanced energy efficiency, leading to considerable cost savings and improved\noperational reliability.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The consolidation of the PMRF power grid under Project P-416 represents a significant\nleap forward in environmental and economic efficiency. This initiative reduces the\ncarbon footprint by optimizing energy distribution and usage, contributing to the\nDepartment of Defense's sustainability goals. Economically, the project promises\nenhanced energy efficiency, leading to considerable cost savings and improved\noperational reliability.",
      "lineHeight": 1.4
    },

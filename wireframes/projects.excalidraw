      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Environmental and Economic Benefits",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Environmental and Economic Benefits",
      "lineHeight": 1.4
    },
    {
      "id": "p4_eb_body",
      "type": "text",
      "x": 752,
      "y": 7650,
      "width": 656,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 424,
      "version": 1,
      "versionNonce": 425,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The Rialto Bio Energy Facility brings profound environmental and economic benefits.\nEnvironmentally, it contributes to a significant reduction in greenhouse gas emissions\nby diverting organic waste from landfills and converting it into clean energy and\nnatural fertilizers. Economically, it provides a sustainable energy source and creates\nlocal jobs, enhancing the economic vitality of the region.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Rialto Bio Energy Facility brings profound environmental and economic benefits.\nEnvironmentally, it contributes to a significant reduction in greenhouse gas emissions\nby diverting organic waste from landfills and converting it into clean energy and\nnatural fertilizers. Economically, it provides a sustainable energy source and creates\nlocal jobs, enhancing the economic vitality of the region.",
      "lineHeight": 1.4
    },

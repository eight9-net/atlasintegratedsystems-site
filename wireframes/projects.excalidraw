      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Environmental and Economic Benefits",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Environmental and Economic Benefits",
      "lineHeight": 1.4
    },
    {
      "id": "p2_eb_body",
      "type": "text",
      "x": 752,
      "y": 3724,
      "width": 656,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 268,
      "version": 1,
      "versionNonce": 269,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The AES-KIUC Lāwa'i Solar Project embodies a significant stride toward environmental and\neconomic sustainability. By tapping into solar energy, the project substantially cuts\ngreenhouse gas emissions, contributing to the fight against climate change.\nEconomically, it provides the local community with a reliable source of clean energy,\npotentially stabilizing energy prices and fostering economic growth.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The AES-KIUC Lāwa'i Solar Project embodies a significant stride toward environmental and\neconomic sustainability. By tapping into solar energy, the project substantially cuts\ngreenhouse gas emissions, contributing to the fight against climate change.\nEconomically, it provides the local community with a reliable source of clean energy,\npotentially stabilizing energy prices and fostering economic growth.",
      "lineHeight": 1.4
    },

      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Environmental and Economic Benefits",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Environmental and Economic Benefits",
      "lineHeight": 1.4
    },
    {
      "id": "p1_eb_body",
      "type": "text",
      "x": 752,
      "y": 1640,
      "width": 656,
      "height": 124,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 186,
      "version": 1,
      "versionNonce": 187,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The City of San Diego's Pure Water Project, driven by Atlas Integrated Systems, Inc.,\ndelivers significant environmental and economic advantages. By reducing the city's\nreliance on imported water, the project minimizes the environmental impact associated\nwith long-distance water transportation and contributes to the region's resilience\nagainst drought. Economically, this initiative is a game-changer, offering a\ncost-effective solution for water supply that promises long-term savings for both the\ncity and its residents.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The City of San Diego's Pure Water Project, driven by Atlas Integrated Systems, Inc.,\ndelivers significant environmental and economic advantages. By reducing the city's\nreliance on imported water, the project minimizes the environmental impact associated\nwith long-distance water transportation and contributes to the region's resilience\nagainst drought. Economically, this initiative is a game-changer, offering a\ncost-effective solution for water supply that promises long-term savings for both the\ncity and its residents.",
      "lineHeight": 1.4
    },

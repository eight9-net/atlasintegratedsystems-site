      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Innovative Water Purification Technology",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Innovative Water Purification Technology",
      "lineHeight": 1.4
    },
    {
      "id": "p1_iw_body",
      "type": "text",
      "x": 32,
      "y": 1036,
      "width": 656,
      "height": 107,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 156,
      "version": 1,
      "versionNonce": 157,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas Integrated Systems, Inc. leverages cutting-edge water purification technology in\nthe City of San Diego's Pure Water Project, setting a new standard in sustainable water\nmanagement. This advanced system employs a multi-barrier approach, incorporating\nprocesses such as microfiltration, reverse osmosis, and advanced ultraviolet light with\nhydrogen peroxide, to ensure the produced water is of the highest quality and meets all\nstate and federal drinking water standards.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas Integrated Systems, Inc. leverages cutting-edge water purification technology in\nthe City of San Diego's Pure Water Project, setting a new standard in sustainable water\nmanagement. This advanced system employs a multi-barrier approach, incorporating\nprocesses such as microfiltration, reverse osmosis, and advanced ultraviolet light with\nhydrogen peroxide, to ensure the produced water is of the highest quality and meets all\nstate and federal drinking water standards.",
      "lineHeight": 1.4
    },

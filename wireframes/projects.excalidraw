    {
      "id": "p2_ce_body",
      "type": "text",
      "x": 32,
      "y": 4066,
      "width": 656,
      "height": 74,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 278,
      "version": 1,
      "versionNonce": 279,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Through the AES-KIUC Lāwa'i Solar Project, Atlas Integrated Systems, Inc. champions\ncommunity engagement and educational outreach. The company works closely with local\ncommunities, schools, and organizations to spread awareness about the benefits of solar\nenergy and the importance of transitioning to renewable resources.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Through the AES-KIUC Lāwa'i Solar Project, Atlas Integrated Systems, Inc. champions\ncommunity engagement and educational outreach. The company works closely with local\ncommunities, schools, and organizations to spread awareness about the benefits of solar\nenergy and the importance of transitioning to renewable resources.",
      "lineHeight": 1.4
    },

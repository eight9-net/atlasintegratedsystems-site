      "text": "Community Engagement and Education",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Community Engagement and Education",
      "lineHeight": 1.4
    },
    {
      "id": "p1_ce_body",
      "type": "text",
      "x": 32,
      "y": 1982,
      "width": 656,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 196,
      "version": 1,
      "versionNonce": 197,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas Integrated Systems, Inc. is at the forefront of community engagement and education\nthrough its involvement in the City of San Diego's Pure Water Project. The company\nactively collaborates with local stakeholders, educational institutions, and community\ngroups to raise awareness about water sustainability and the importance of the Pure\nWater Project.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas Integrated Systems, Inc. is at the forefront of community engagement and education\nthrough its involvement in the City of San Diego's Pure Water Project. The company\nactively collaborates with local stakeholders, educational institutions, and community\ngroups to raise awareness about water sustainability and the importance of the Pure\nWater Project.",
      "lineHeight": 1.4
    },

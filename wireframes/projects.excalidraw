      "originalText": "Innovative Power Grid Consolidation Technology",
      "lineHeight": 1.4
    },
    {
      "id": "p3_ig_body",
      "type": "text",
      "x": 32,
      "y": 5184,
      "width": 656,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 320,
      "version": 1,
      "versionNonce": 321,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The FY16 MCON Project P-416 at the Pacific Missile Range Facility (PMRF) showcases Atlas\nIntegrated Systems, Inc.'s expertise in advanced energy solutions through the\nconsolidation of the power grid. This project employs state-of-the-art technology to\nenhance the efficiency and reliability of the power distribution system, significantly\nimproving energy management and resilience at PMRF.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The FY16 MCON Project P-416 at the Pacific Missile Range Facility (PMRF) showcases Atlas\nIntegrated Systems, Inc.'s expertise in advanced energy solutions through the\nconsolidation of the power grid. This project employs state-of-the-art technology to\nenhance the efficiency and reliability of the power distribution system, significantly\nimproving energy management and resilience at PMRF.",
      "lineHeight": 1.4
    },

      "roundness": null,
      "seed": 396,
      "version": 1,
      "versionNonce": 397,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas furnished and installed apx. 4800' of new 12 fiber OM3 multimode cable in new and\nexisting ducts and hand holes for SCADA network per Drawings. We terminated and tested\nall fibers in 12 locations in 24 new patch panels in new SCADA cabinet(s). Furnished and\nInstalled Innerduct where required and where cable tray is exposed. Additionally, Atlas\nwas brought in to certify entire administration building communications systems\nProviding Certification Testing for both cabling systems.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas furnished and installed apx. 4800' of new 12 fiber OM3 multimode cable in new and\nexisting ducts and hand holes for SCADA network per Drawings. We terminated and tested\nall fibers in 12 locations in 24 new patch panels in new SCADA cabinet(s). Furnished and\nInstalled Innerduct where required and where cable tray is exposed. Additionally, Atlas\nwas brought in to certify entire administration building communications systems\nProviding Certification Testing for both cabling systems.",
      "lineHeight": 1.4
    },

      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Innovative Solar Energy Technology",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Innovative Solar Energy Technology",
      "lineHeight": 1.4
    },
    {
      "id": "p2_is_body",
      "type": "text",
      "x": 32,
      "y": 3100,
      "width": 656,
      "height": 107,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 238,
      "version": 1,
      "versionNonce": 239,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The AES-KIUC Lāwa'i Solar Project stands as a testament to Atlas Integrated Systems,\nInc.'s commitment to renewable energy innovation. This project harnesses cutting-edge\nsolar technology to generate clean, sustainable energy, reducing reliance on fossil\nfuels and lowering carbon emissions. By incorporating advanced solar panels and energy\nstorage systems, the project ensures a consistent power supply, even during non-daylight\nhours.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The AES-KIUC Lāwa'i Solar Project stands as a testament to Atlas Integrated Systems,\nInc.'s commitment to renewable energy innovation. This project harnesses cutting-edge\nsolar technology to generate clean, sustainable energy, reducing reliance on fossil\nfuels and lowering carbon emissions. By incorporating advanced solar panels and energy\nstorage systems, the project ensures a consistent power supply, even during non-daylight\nhours.",
      "lineHeight": 1.4
    },

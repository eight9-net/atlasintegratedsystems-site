      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Innovative Data Center Design",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Innovative Data Center Design",
      "lineHeight": 1.4
    },
    {
      "id": "p5_id_body",
      "type": "text",
      "x": 32,
      "y": 9110,
      "width": 656,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 476,
      "version": 1,
      "versionNonce": 477,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The Camp Pendleton Data Center project, facilitated by Atlas Integrated Systems, Inc.,\nmarks a significant advancement in military data management and IT infrastructure. This\nproject involves the creation of a state-of-the-art data center that utilizes innovative\ncooling and energy-efficient technologies to reduce its footprint and increase\noperational capacity.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Camp Pendleton Data Center project, facilitated by Atlas Integrated Systems, Inc.,\nmarks a significant advancement in military data management and IT infrastructure. This\nproject involves the creation of a state-of-the-art data center that utilizes innovative\ncooling and energy-efficient technologies to reduce its footprint and increase\noperational capacity.",
      "lineHeight": 1.4
    },

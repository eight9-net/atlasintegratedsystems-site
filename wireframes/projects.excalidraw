      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Project Milestones",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Project Milestones",
      "lineHeight": 1.4
    },
    {
      "id": "p5_ms_body",
      "type": "text",
      "x": 752,
      "y": 8768,
      "width": 656,
      "height": 124,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 466,
      "version": 1,
      "versionNonce": 467,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas was brought in to certify entire fiber optic communications systems for all the\nprocessing functions throughout the newly installed Data Center, Providing Certification\nTesting for both SIPER and NIPER Networks for external and base wide connections. We\nconducted OTDR (Optical Time Domain Reflectometer) Testing for over 5000 fiber\nconnectors in 300 newly installed enclosed racks within the new Data Center on Camp\nPendleton Marine Base. Work included all documentation and repair of any and all fiber\nconnectors not meeting R+M manufacturers specifications.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas was brought in to certify entire fiber optic communications systems for all the\nprocessing functions throughout the newly installed Data Center, Providing Certification\nTesting for both SIPER and NIPER Networks for external and base wide connections. We\nconducted OTDR (Optical Time Domain Reflectometer) Testing for over 5000 fiber\nconnectors in 300 newly installed enclosed racks within the new Data Center on Camp\nPendleton Marine Base. Work included all documentation and repair of any and all fiber\nconnectors not meeting R+M manufacturers specifications.",
      "lineHeight": 1.4
    },

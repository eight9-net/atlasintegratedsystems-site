      "text": "Community Engagement and Education",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Community Engagement and Education",
      "lineHeight": 1.4
    },
    {
      "id": "p4_ce_body",
      "type": "text",
      "x": 32,
      "y": 7992,
      "width": 656,
      "height": 107,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 434,
      "version": 1,
      "versionNonce": 435,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Atlas Integrated Systems, Inc. places a high priority on community engagement and\neducation in the Rialto Bio Energy Facility project. The company is committed to\ntransparent communication with the local population, offering educational tours and\ncommunity meetings to explain the benefits of bioenergy. They also collaborate with\nlocal educational institutions to foster a better understanding of sustainable energy\npractices.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atlas Integrated Systems, Inc. places a high priority on community engagement and\neducation in the Rialto Bio Energy Facility project. The company is committed to\ntransparent communication with the local population, offering educational tours and\ncommunity meetings to explain the benefits of bioenergy. They also collaborate with\nlocal educational institutions to foster a better understanding of sustainable energy\npractices.",
      "lineHeight": 1.4
    },

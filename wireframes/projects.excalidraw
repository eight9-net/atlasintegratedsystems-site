    {
      "id": "p5_ce_body",
      "type": "text",
      "x": 32,
      "y": 9794,
      "width": 656,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 504,
      "version": 1,
      "versionNonce": 505,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Community engagement and education are key components of the Camp Pendleton Data Center\nproject. Atlas Integrated Systems, Inc. actively involves military and civilian\nstakeholders in the project, ensuring that the data center meets the dynamic needs of\nCamp Pendleton's operations. Through workshops, seminars, and collaborative discussions,\nthe company fosters an environment of learning and adaptation.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Community engagement and education are key components of the Camp Pendleton Data Center\nproject. Atlas Integrated Systems, Inc. actively involves military and civilian\nstakeholders in the project, ensuring that the data center meets the dynamic needs of\nCamp Pendleton's operations. Through workshops, seminars, and collaborative discussions,\nthe company fosters an environment of learning and adaptation.",
      "lineHeight": 1.4
    },

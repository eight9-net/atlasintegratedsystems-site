      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Project Activities & Solutions",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Project Activities & Solutions",
      "lineHeight": 1.4
    },
    {
      "id": "p3_ms_body",
      "type": "text",
      "x": 752,
      "y": 4842,
      "width": 656,
      "height": 158,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 310,
      "version": 1,
      "versionNonce": 311,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "This project for the Navy's Pacific Missile Range Facility integrated the power\ngenerated from the AES-KIUC Solar site we had installed under an earlier contract. It\nallowed the transfer of power to the entire Navy Base. Atlas produced pull plans and as\nbuilt patching matrix's, furnished and installed apx. 29,000' of new innerduct and 48\nfiber single mode cable in new and existing ducts and hand holes for various SCADA,\nPower and security networks per Drawings and Rigid Military Specifications.\nAdditionally, Atlas was brought in to certify entire administration building\ncommunications systems Providing Certification Testing for both new and existing cabling\nsystems.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This project for the Navy's Pacific Missile Range Facility integrated the power\ngenerated from the AES-KIUC Solar site we had installed under an earlier contract. It\nallowed the transfer of power to the entire Navy Base. Atlas produced pull plans and as\nbuilt patching matrix's, furnished and installed apx. 29,000' of new innerduct and 48\nfiber single mode cable in new and existing ducts and hand holes for various SCADA,\nPower and security networks per Drawings and Rigid Military Specifications.\nAdditionally, Atlas was brought in to certify entire administration building\ncommunications systems Providing Certification Testing for both new and existing cabling\nsystems.",
      "lineHeight": 1.4
    },

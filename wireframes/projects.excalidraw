    {
      "id": "p3_ce_body",
      "type": "text",
      "x": 32,
      "y": 6190,
      "width": 656,
      "height": 107,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 364,
      "version": 1,
      "versionNonce": 365,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "While the FY16 MCON Project P-416 primarily focuses on military infrastructure, Atlas\nIntegrated Systems, Inc. understands the importance of community engagement and\neducation within the broader context of energy and environmental stewardship. Through\ninformational sessions, workshops, and collaboration with local and military\nstakeholders, Atlas Integrated Systems, Inc. promotes awareness and fosters a culture of\nsustainability and resilience.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "While the FY16 MCON Project P-416 primarily focuses on military infrastructure, Atlas\nIntegrated Systems, Inc. understands the importance of community engagement and\neducation within the broader context of energy and environmental stewardship. Through\ninformational sessions, workshops, and collaboration with local and military\nstakeholders, Atlas Integrated Systems, Inc. promotes awareness and fosters a culture of\nsustainability and resilience.",
      "lineHeight": 1.4
    },

      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Innovative Bioenergy Technology",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Innovative Bioenergy Technology",
      "lineHeight": 1.4
    },
    {
      "id": "p4_ib_body",
      "type": "text",
      "x": 32,
      "y": 7308,
      "width": 656,
      "height": 107,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 406,
      "version": 1,
      "versionNonce": 407,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The Rialto Bio Energy Facility project represents a pioneering leap in bioenergy\ntechnology, spearheaded by Atlas Integrated Systems, Inc. This facility utilizes\nadvanced anaerobic digestion technology to convert organic waste into renewable energy\nand soil amendments, showcasing a commitment to innovation and sustainable resource\nmanagement. The project not only diverts waste from landfills but also generates clean,\ngreen energy.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Rialto Bio Energy Facility project represents a pioneering leap in bioenergy\ntechnology, spearheaded by Atlas Integrated Systems, Inc. This facility utilizes\nadvanced anaerobic digestion technology to convert organic waste into renewable energy\nand soil amendments, showcasing a commitment to innovation and sustainable resource\nmanagement. The project not only diverts waste from landfills but also generates clean,\ngreen energy.",
      "lineHeight": 1.4
    },
